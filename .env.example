HOST=0.0.0.0
PORT=3000

LOG_LEVEL=info
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

WEBHOOK_SECRET=
WEBHOOK_MAX_AGE_SECONDS=300

WEB_API_BASE_URL=http://nginx
WEB_API_HOST_HEADER=api.localhost
WEB_API_CLIENT_ID=
WEB_API_CLIENT_SECRET=
WEB_API_SCOPE=discord.roles.sync
WEB_API_CONNECT_TIMEOUT_MS=3000
WEB_API_REQUEST_TIMEOUT_MS=5000
WEB_API_MAX_RETRIES=3

SQLITE_PATH=/data/pcb-discord-bot.sqlite

QUEUE_MAX_SIZE=10000
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_BASE_MS=1000
QUEUE_RETRY_MAX_MS=60000
QUEUE_POLL_INTERVAL_MS=500
QUEUE_CONCURRENCY=4